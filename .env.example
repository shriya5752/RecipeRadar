# Copy to .env.local (Next.js loads it automatically). Never commit real secrets.

# Runtime connection used by the Next.js API: the low-privilege rr_app login role.
DATABASE_URL=postgres://rr_app:change-me@localhost:5432/reciperadar

# Owner/superuser connection used ONLY by setup scripts (db:setup, db:audit, db:backup, db:promote-admin).
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/reciperadar

# Password given to the rr_app login role by `npm run db:setup` (must match DATABASE_URL).
RR_APP_PASSWORD=change-me

# Optional: use an external Qdrant service instead of the in-database vector store.
# QDRANT_URL=http://localhost:6333

# Optional: override the demo account passwords created on first setup (SEED_DEMO=0 skips demo data).
# SEED_DEMO_PASSWORD=
# SEED_ADMIN_PASSWORD=
