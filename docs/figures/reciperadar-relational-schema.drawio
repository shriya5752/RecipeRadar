<mxfile host="app.diagrams.net"><diagram name="RecipeRadar Relational Schema"><mxGraphModel background="#f6faf8" page="1" pageWidth="1600" pageHeight="1205"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="RecipeRadar Relational Schema" style="text;align=left;fontSize=40;fontColor=#15382e;html=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="42" y="30" width="1490" height="44" /></mxCell><mxCell id="legend" value="18 PostgreSQL application tables  |  PK = primary key  |  FK = foreign key  |  Each FK lists its referenced table" style="text;align=left;fontSize=17;fontColor=#15382e;html=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="42" y="85" width="1490" height="21" /></mxCell><mxCell id="note" value="Multiple PK labels in one table indicate a composite key. search_vector is generated. Outbox recipe_id and audit actor_user_id have no FK." style="text;align=left;fontSize=16;fontColor=#15382e;html=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="42" y="110" width="1490" height="20" /></mxCell><mxCell id="recipes" value="&lt;b&gt;recipes&lt;/b&gt;&lt;hr/&gt;recipe_id  [PK]&lt;br/&gt;title&lt;br/&gt;description&lt;br/&gt;instructions&lt;br/&gt;prep_time_minutes&lt;br/&gt;cook_time_minutes&lt;br/&gt;servings&lt;br/&gt;calories_per_serving&lt;br/&gt;protein_g&lt;br/&gt;carbs_g&lt;br/&gt;fat_g&lt;br/&gt;avg_rating&lt;br/&gt;total_views&lt;br/&gt;cuisine_id  [FK]  → cuisines&lt;br/&gt;diet_id  [FK]  → dietary_types&lt;br/&gt;created_by  [FK]  → users&lt;br/&gt;is_approved&lt;br/&gt;created_at&lt;br/&gt;image&lt;br/&gt;meal_type&lt;br/&gt;flavor&lt;br/&gt;search_vector" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#739a8b;fontColor=#15382e;align=left;verticalAlign=top;spacing=9;fontSize=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="42" y="154" width="365" height="550" /></mxCell><mxCell id="cuisines" value="&lt;b&gt;cuisines&lt;/b&gt;&lt;hr/&gt;cuisine_id  [PK]&lt;br/&gt;name" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#739a8b;fontColor=#15382e;align=left;verticalAlign=top;spacing=9;fontSize=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="42" y="723" width="365" height="90" /></mxCell><mxCell id="dietary_types" value="&lt;b&gt;dietary_types&lt;/b&gt;&lt;hr/&gt;diet_id  [PK]&lt;br/&gt;name" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#739a8b;fontColor=#15382e;align=left;verticalAlign=top;spacing=9;fontSize=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="42" y="832" width="365" height="90" /></mxCell><mxCell id="users" value="&lt;b&gt;users&lt;/b&gt;&lt;hr/&gt;user_id  [PK]&lt;br/&gt;name&lt;br/&gt;email&lt;br/&gt;password_hash&lt;br/&gt;role&lt;br/&gt;age&lt;br/&gt;diet_goal&lt;br/&gt;daily_calorie_target&lt;br/&gt;created_at" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#739a8b;fontColor=#15382e;align=left;verticalAlign=top;spacing=9;fontSize=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="426" y="154" width="365" height="251" /></mxCell><mxCell id="ratings" value="&lt;b&gt;ratings&lt;/b&gt;&lt;hr/&gt;user_id  [PK FK]  → users&lt;br/&gt;recipe_id  [PK FK]  → recipes&lt;br/&gt;rating_value&lt;br/&gt;review_text&lt;br/&gt;created_at" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#739a8b;fontColor=#15382e;align=left;verticalAlign=top;spacing=9;fontSize=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="426" y="424" width="365" height="159" /></mxCell><mxCell id="favorites" value="&lt;b&gt;favorites&lt;/b&gt;&lt;hr/&gt;user_id  [PK FK]  → users&lt;br/&gt;recipe_id  [PK FK]  → recipes&lt;br/&gt;saved_at" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#739a8b;fontColor=#15382e;align=left;verticalAlign=top;spacing=9;fontSize=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="426" y="602" width="365" height="113" /></mxCell><mxCell id="sessions" value="&lt;b&gt;sessions&lt;/b&gt;&lt;hr/&gt;token  [PK]&lt;br/&gt;user_id  [FK]  → users&lt;br/&gt;expires_at" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#739a8b;fontColor=#15382e;align=left;verticalAlign=top;spacing=9;fontSize=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="426" y="734" width="365" height="113" /></mxCell><mxCell id="user_allergens" value="&lt;b&gt;user_allergens&lt;/b&gt;&lt;hr/&gt;user_id  [PK FK]  → users&lt;br/&gt;allergen_id  [PK FK]  → allergens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#739a8b;fontColor=#15382e;align=left;verticalAlign=top;spacing=9;fontSize=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="426" y="866" width="365" height="90" /></mxCell><mxCell id="ingredients" value="&lt;b&gt;ingredients&lt;/b&gt;&lt;hr/&gt;ingredient_id  [PK]&lt;br/&gt;name&lt;br/&gt;category&lt;br/&gt;unit&lt;br/&gt;is_common_allergen&lt;br/&gt;flavor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#739a8b;fontColor=#15382e;align=left;verticalAlign=top;spacing=9;fontSize=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="810" y="154" width="365" height="182" /></mxCell><mxCell id="recipe_ingredients" value="&lt;b&gt;recipe_ingredients&lt;/b&gt;&lt;hr/&gt;recipe_id  [PK FK]  → recipes&lt;br/&gt;ingredient_id  [PK FK]  → ingredients&lt;br/&gt;quantity&lt;br/&gt;unit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#739a8b;fontColor=#15382e;align=left;verticalAlign=top;spacing=9;fontSize=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="810" y="355" width="365" height="136" /></mxCell><mxCell id="ingredient_allergens" value="&lt;b&gt;ingredient_allergens&lt;/b&gt;&lt;hr/&gt;ingredient_id  [PK FK]  → ingredients&lt;br/&gt;allergen_id  [PK FK]  → allergens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#739a8b;fontColor=#15382e;align=left;verticalAlign=top;spacing=9;fontSize=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="810" y="510" width="365" height="90" /></mxCell><mxCell id="allergens" value="&lt;b&gt;allergens&lt;/b&gt;&lt;hr/&gt;allergen_id  [PK]&lt;br/&gt;name&lt;br/&gt;severity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#739a8b;fontColor=#15382e;align=left;verticalAlign=top;spacing=9;fontSize=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="810" y="619" width="365" height="113" /></mxCell><mxCell id="substitutions" value="&lt;b&gt;substitutions&lt;/b&gt;&lt;hr/&gt;ingredient_id_from  [PK FK]  → ingredients&lt;br/&gt;ingredient_id_to  [PK FK]  → ingredients&lt;br/&gt;similarity_score" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#739a8b;fontColor=#15382e;align=left;verticalAlign=top;spacing=9;fontSize=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="810" y="751" width="365" height="113" /></mxCell><mxCell id="meal_plans" value="&lt;b&gt;meal_plans&lt;/b&gt;&lt;hr/&gt;plan_id  [PK]&lt;br/&gt;user_id  [FK]  → users&lt;br/&gt;plan_name&lt;br/&gt;start_date&lt;br/&gt;end_date&lt;br/&gt;is_active&lt;br/&gt;created_at" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#739a8b;fontColor=#15382e;align=left;verticalAlign=top;spacing=9;fontSize=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="1194" y="154" width="365" height="205" /></mxCell><mxCell id="meal_plan_recipes" value="&lt;b&gt;meal_plan_recipes&lt;/b&gt;&lt;hr/&gt;plan_id  [PK FK]  → meal_plans&lt;br/&gt;recipe_id  [FK]  → recipes&lt;br/&gt;meal_date  [PK]&lt;br/&gt;meal_type  [PK]&lt;br/&gt;servings_planned" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#739a8b;fontColor=#15382e;align=left;verticalAlign=top;spacing=9;fontSize=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="1194" y="378" width="365" height="159" /></mxCell><mxCell id="vector_documents" value="&lt;b&gt;vector_documents&lt;/b&gt;&lt;hr/&gt;recipe_id  [PK FK]  → recipes&lt;br/&gt;embedding&lt;br/&gt;payload&lt;br/&gt;updated_at" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#739a8b;fontColor=#15382e;align=left;verticalAlign=top;spacing=9;fontSize=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="1194" y="556" width="365" height="136" /></mxCell><mxCell id="vector_sync_outbox" value="&lt;b&gt;vector_sync_outbox&lt;/b&gt;&lt;hr/&gt;outbox_id  [PK]&lt;br/&gt;recipe_id&lt;br/&gt;operation&lt;br/&gt;payload&lt;br/&gt;attempts&lt;br/&gt;last_error&lt;br/&gt;created_at" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#739a8b;fontColor=#15382e;align=left;verticalAlign=top;spacing=9;fontSize=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="1194" y="711" width="365" height="205" /></mxCell><mxCell id="audit_log" value="&lt;b&gt;audit_log&lt;/b&gt;&lt;hr/&gt;audit_id  [PK]&lt;br/&gt;table_name&lt;br/&gt;record_id&lt;br/&gt;action&lt;br/&gt;old_value&lt;br/&gt;new_value&lt;br/&gt;actor_user_id&lt;br/&gt;db_role&lt;br/&gt;changed_at" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#739a8b;fontColor=#15382e;align=left;verticalAlign=top;spacing=9;fontSize=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="1194" y="935" width="365" height="251" /></mxCell></root></mxGraphModel></diagram></mxfile>